[Unit]
Description=DeepSeek Unofficial Web API Service
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/projects/deepseek-api
ExecStart=/usr/local/lib/hermes-agent/venv/bin/python3 /root/projects/deepseek-api/main.py
Restart=always
RestartSec=3s
Environment=PORT=8550
Environment=HOST=127.0.0.1
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
